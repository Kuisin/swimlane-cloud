# Environment variables for the Next.js app deployed on Vercel.
# Add these in: Vercel dashboard → Project → Settings → Environment Variables.
# For the Gitea server (EC2), see .env.example.

# ── App URL ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com

# ── Gitea (public URL of the EC2 server) ─────────────────────────────────────
GITEA_URL=https://git.yourdomain.com
GITEA_ADMIN_TOKEN=                          # same token from EC2 Step 8

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AWS S3 — SVG blob storage ────────────────────────────────────────────────
# Vercel has no IAM role, so explicit credentials are required.
# Create a dedicated IAM user with the s3:GetObject/PutObject/DeleteObject
# policy scoped to the SVG bucket, and paste the access key here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SVG_BUCKET=swimlane-svg-blobs

# ── AWS SES — transactional email from the app ───────────────────────────────
# The app uses the AWS SDK directly (not SMTP), so no separate SMTP credentials.
# The IAM user above needs ses:SendEmail added to its policy.
SES_FROM_EMAIL=noreply@yourdomain.com

# ── Next.js auth ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=                            # openssl rand -hex 32

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
