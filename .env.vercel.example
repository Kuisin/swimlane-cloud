# Environment variables for apps/saas on Vercel.
# Add these in: Vercel dashboard → Project → Settings → Environment Variables
# (or `vercel env add <NAME> production` from the repo root).
#
# `next build` reads none of them — every value is read at request time — so a
# missing variable is a runtime error with a clear message, never a failed build.

# ── Supabase (project in ap-northeast-1 / Tokyo) ─────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://okrcmywyekqwvgdgoexj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                  # server only; never exposed to the browser

# ── GitHub token encryption ──────────────────────────────────────────────────
# Each user's GitHub OAuth token is stored AES-256-GCM encrypted under this key.
# Rotating it invalidates stored tokens; users simply sign in again.
TOKEN_ENCRYPTION_KEY=                       # openssl rand -hex 32

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://swimlane-cloud-saas.vercel.app

# ── Optional ─────────────────────────────────────────────────────────────────
# GITHUB_API_ORIGIN=https://github.example.com/api/v3   # GitHub Enterprise Server
# STRIPE_SECRET_KEY=sk_live_...                          # billing webhook (deferred)
# STRIPE_WEBHOOK_SECRET=whsec_...
