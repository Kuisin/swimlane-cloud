# Environment variables for the Gitea EC2 server.
# For the Next.js app (Vercel), see .env.vercel.example.

# ── Domain ────────────────────────────────────────────────────────────────────
GITEA_DOMAIN=git.yourdomain.com
CERTBOT_EMAIL=you@yourdomain.com

# ── Gitea database ────────────────────────────────────────────────────────────
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-strong-password
GITEA_DB_NAME=gitea

# ── Gitea secrets (generate with: openssl rand -hex 32) ──────────────────────
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=

# ── Gitea bot account (set after running Step 8) ─────────────────────────────
# Not used by docker-compose directly; stored here for reference.
GITEA_ADMIN_TOKEN=

# ── AWS SES — Gitea email (optional) ─────────────────────────────────────────
# Set GITEA_MAILER_ENABLED=true and fill in the SMTP credentials to enable.
# SES SMTP credentials are separate from IAM keys — generate them in the SES console.
AWS_REGION=us-east-1
GITEA_MAILER_ENABLED=false
GITEA_SES_FROM=noreply@yourdomain.com
SES_SMTP_USER=
SES_SMTP_PASSWORD=
