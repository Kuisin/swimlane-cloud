# ── Domains ───────────────────────────────────────────────────────────────────
APP_DOMAIN=app.yourdomain.com
GITEA_DOMAIN=git.yourdomain.com
CERTBOT_EMAIL=you@yourdomain.com

# ── Gitea database ────────────────────────────────────────────────────────────
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-strong-password
GITEA_DB_NAME=gitea

# ── Gitea secrets (generate with: openssl rand -hex 32) ──────────────────────
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=

# ── Gitea bot account (create after first boot) ───────────────────────────────
GITEA_ADMIN_TOKEN=

# ── Supabase (create project at supabase.com) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── SVG blob storage bucket name (Supabase Storage or S3-compatible) ──────────
SVG_STORAGE_BUCKET=svg-blobs

# ── Next.js auth ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-strong-secret

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
