# ── Domains ───────────────────────────────────────────────────────────────────
APP_DOMAIN=app.yourdomain.com
GITEA_DOMAIN=git.yourdomain.com
CERTBOT_EMAIL=you@yourdomain.com

# ── Gitea database ────────────────────────────────────────────────────────────
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-strong-password
GITEA_DB_NAME=gitea

# ── Gitea secrets (generate with: openssl rand -hex 32) ──────────────────────
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=

# ── Gitea bot account (create after first boot) ───────────────────────────────
GITEA_ADMIN_TOKEN=

# ── Supabase — auth + app database (supabase.com) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AWS — S3 (SVG blob storage) ───────────────────────────────────────────────
# On EC2, credentials are supplied by the attached IAM role — no keys needed.
# For local dev, set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY instead.
AWS_REGION=us-east-1
S3_SVG_BUCKET=swimlane-svg-blobs

# ── AWS — SES (transactional email, optional) ─────────────────────────────────
# Verify the sender domain in SES, then create SMTP credentials in IAM.
# Leave blank to disable email entirely.
SES_FROM_EMAIL=noreply@yourdomain.com
SES_SMTP_USER=
SES_SMTP_PASSWORD=
GITEA_SES_FROM=noreply@yourdomain.com

# ── Next.js auth ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-strong-secret

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
