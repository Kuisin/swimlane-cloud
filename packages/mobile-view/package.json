{
  "name": "@swimlane-cloud/mobile-view",
  "version": "0.1.0",
  "description": "Converts the parsed kai-swimlane model into mobile-friendly React components (vertical, card-based). Separate from the SVG renderer and the desktop editor; a base for a future mobile editor.",
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.jsx"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@swimlane-cloud/diagram-converter": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=0.4",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.2.4",
    "prettier": "^3.9.6"
  }
}
