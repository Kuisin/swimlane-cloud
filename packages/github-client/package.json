{
  "name": "@swimlane-cloud/github-client",
  "version": "0.1.0",
  "description": "Zero-dependency GitHub client over fetch. Never imports Next, never acquires a token \u2014 callers inject both the token getter and the caching policy. Shared by the stateless hub and the VS Code extension.",
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rest": "./src/rest.ts",
    "./refs": "./src/refs.ts",
    "./raw": "./src/raw.ts",
    "./branch-model": "./src/branch-model.ts",
    "./write": "./src/write.ts",
    "./pulls": "./src/pulls.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "prettier": "^3.9.6"
  }
}
